# Copy to .env and fill in. Never commit .env.
# Vite only exposes vars prefixed with VITE_ to the client — assume anything
# here is PUBLIC. Never put a service-role key or private API secret in this file.

# SignSphere's built-in backend server. npm run dev / npm start set this to /api for you.
# For a hosted server, put its address here (e.g. https://api.example.org/api).
VITE_API_URL=

# Supabase — logins, accounts and synced history. Supabase dashboard → Project Settings
# → API: copy the Project URL and the *anon public* key. NEVER the service_role key.
# Left blank, the app runs in "device mode": accounts and history stay on this device only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL for signer video clips. Defaults to /clips (served from public/) when unset.
VITE_CLIP_BASE_URL=

# Trained sign classifier (ONNX). Leave blank to use the on-device template
# classifier built from locally recorded samples — see docs/architecture.md.
VITE_MODEL_URL=

# Shown on the Privacy page as the contact for data requests.
VITE_SUPPORT_EMAIL=

# Public address of the hosted app, used for the "Open on another device" QR code.
# Defaults to the GitHub Pages address.
VITE_PUBLIC_URL=

{
  "name": "signsphere",
  "private": true,
  "version": "0.1.0",
  "description": "ISL learning and communication platform \u2014 on-device sign recognition, gloss-based text-to-sign",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @signsphere/web",
    "build": "npm run build --workspace @signsphere/web",
    "preview": "npm run preview --workspace @signsphere/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run test:db",
    "test:db": "node supabase/tests/rls.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
